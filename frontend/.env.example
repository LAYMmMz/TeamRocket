# demo: local deterministic synthetic UI fixtures; api: FastAPI-driven backend
VITE_DATA_MODE=demo
VITE_API_BASE_URL=http://localhost:8000/api/v1
# NEVER put database passwords / service-role keys in Vite environment variables

# Public Supabase browser authentication configuration; never use a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
