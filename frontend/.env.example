# public: login-free real reads from approved synthetic Supabase via FastAPI
# demo: static browser fixtures, no database; api: private JWT-required endpoints
# Judges' Vercel Production build is configured with VITE_DATA_MODE=public.
# Database-backed reads are the default. Fixtures require explicit demo mode.
VITE_DATA_MODE=public
# Local API: http://localhost:8000/api/v1 when calling backend directly.
# Hosted Vercel build: /api/v1 (frontend/vercel.json rewrites to Railway).
VITE_API_BASE_URL=/api/v1
# NEVER put database passwords / service-role keys in Vite environment variables

# Public Supabase browser authentication configuration; never use a secret or service-role key.
# Names beginning NEXT_PUBLIC_ apply to Next.js, not to this Vite frontend.
VITE_SUPABASE_URL=https://ziecxjoeljxoocixejtz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback if the project still uses an anon JWT key (optional):
# VITE_SUPABASE_ANON_KEY=
