  "scenarios": [
    {
      "id": "S01",
      "name": "Normal crew vitals and environment",
      "expected": "Normal charts, simulation badges, no spurious clinical alerts",
      "kind": "normal"
    },
    {
      "id": "S02",
      "name": "High HR coinciding with workout",
      "expected": "Activity context; do not confuse elevated workout HR with resting abnormality",
      "kind": "exercise"
    },
    {
      "id": "S03",
      "name": "Serious breathing symptom; SpO₂ absent",
      "expected": "Local incident; unavailable sensor remains missing, not fabricated",
      "kind": "breathing"
    },
    {
      "id": "S04",
      "name": "CO₂ time-window incident + headache symptom",
      "expected": "One evidence-linked incident with a versioned demo rule and acknowledgement",
      "kind": "co2"
    },
    {
      "id": "S05",
      "name": "Clinically unreviewed D-dimer",
      "expected": "Review queue, never diagnose clot",
      "kind": "review"
    },
    {
      "id": "S06",
      "name": "Left-side vascular ultrasound finding",
      "expected": "Left-side record and clinician review",
      "kind": "vascular"
    },
    {
      "id": "S07",
      "name": "Solar particle event + stale dosimeter",
      "expected": "Labeled radiation notification, dose compatibility and stale flag",
      "kind": "spe"
    },
    {
      "id": "S08",
      "name": "OCT due; no in-flight DXA",
      "expected": "Reminders and missing BMD clearly marked; no invented readings",
      "kind": "exam"
    },
    {
      "id": "S09",
      "name": "Environmental water culture flag",
      "expected": "Show sampling method/unit, review and re-sampling request",
      "kind": "water"
    },
    {
      "id": "S10",
      "name": "Disconnect and reconnect",
      "expected": "Local persistence, receipts, no duplicate alerts",
      "kind": "offline"
    },
    {
      "id": "S11",
      "name": "Expired procedure and unapproved clinical rule",
      "expected": "Historical reference only; no treatment guidance",
      "kind": "expired"
    },
    {
      "id": "S12",
      "name": "Unauthorized confidential check-in access",
      "expected": "Deny and audit in backend; UI demo shows restricted view",
      "kind": "denied"
    }
