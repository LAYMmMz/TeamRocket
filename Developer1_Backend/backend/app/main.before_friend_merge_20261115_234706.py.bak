
from contextlib import asynccontextmanager
import asyncio
import logging
from uuid import uuid4

from fastapi import FastAPI, Request, Depends
from fastapi.exceptions import RequestValidationError
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import JSONResponse
from starlette.exceptions import HTTPException

from app.core.config import Settings
from app.core.body_limit import BodyLimitMiddleware
from app.core.errors import AppError
from app.offline.store import Store
from app.sync.worker import HTTPReceiptTransport, SyncWorker


def create_app(settings=None):
    settings = settings or Settings()

    @asynccontextmanager
    async def lifespan(app):
        settings.validate()
        app.state.store = Store(settings)
        app.state.sync_worker = SyncWorker(
            app.state.store,
            HTTPReceiptTransport(settings),
            settings.sync_max_attempts,
            settings.sync_batch_size,
        )
        stop = asyncio.Event()

        async def synchronize():
            while not stop.is_set():
                try:
                    await asyncio.to_thread(
                        app.state.sync_worker.run_once
                    )
                except Exception as exc:
                    logging.getLogger(__name__).error(
                        "Sync cycle failed: %s",
                        type(exc).__name__
                    )

                try:
                    await asyncio.wait_for(
                        stop.wait(),
                        timeout=settings.sync_interval_seconds
                    )
                except TimeoutError:
                    pass

        task = (
            asyncio.create_task(synchronize())
            if settings.sync_rpc_url and settings.sync_access_token
            else None
        )

        # TeamRocket SQLite automatic reconciliation (development only).
        mirror_stop = asyncio.Event()
        mirror_task = None
        if settings.environment == "development":
            from team_sqlite_integration import integration_ready, reconcile
            if integration_ready():
                async def mirror_loop():
                    while not mirror_stop.is_set():
                        try:
                            await asyncio.to_thread(reconcile, app.state.store)
                        except Exception as exc:
                            logging.getLogger(__name__).warning(
                                "Team SQLite reconciliation failed: %s",
                                type(exc).__name__,
                            )
                        try:
                            await asyncio.wait_for(mirror_stop.wait(), timeout=10.0)
                        except TimeoutError:
                            pass
                mirror_task = asyncio.create_task(mirror_loop())

        try:
            yield
        finally:
            mirror_stop.set()
            if mirror_task is not None:
                await mirror_task
            stop.set()
            if task:
                await task
            app.state.store.close()

    app = FastAPI(
        title="Astronaut Health Monitoring — Developer 1 API",
        version="0.1.0",
        lifespan=lifespan,
        description=(
            "Synthetic-data prototype. Cloud schema and "
            "clinical approvals require team handoff."
        ),
    )

    app.state.settings = settings

    app.add_middleware(
        BodyLimitMiddleware,
        max_bytes=15_000_000
    )

    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.cors_origins,
        allow_credentials=True,
        allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        allow_headers=[
            "Authorization",
            "Content-Type",
            "X-Request-ID"
        ],
    )

    def error_response(
        request, status, code, message, details=None
    ):
        return JSONResponse(
            status_code=status,
            content={
                "error": {
                    "code": code,
                    "message": message,
                    "details": details,
                },
                "request_id": getattr(
                    request.state, "request_id", ""
                ),
            },
        )

    @app.middleware("http")
    async def envelope(request: Request, call_next):
        request.state.request_id = str(uuid4())

        origin = request.headers.get("origin")
        if origin and origin not in settings.cors_origins:
            return error_response(
                request,
                403,
                "origin_forbidden",
                "Origin is not allowed"
            )

        length = request.headers.get("content-length")

        if length:
            try:
                if int(length) < 0 or int(length) > 15_000_000:
                    return error_response(
                        request,
                        413,
                        "request_too_large",
                        "Request exceeds the backend limit"
                    )
            except ValueError:
                return error_response(
                    request,
                    400,
                    "invalid_content_length",
                    "Invalid Content-Length"
                )

        response = await call_next(request)

        response.headers["X-Request-ID"] = request.state.request_id
        response.headers["Cache-Control"] = "no-store"
        response.headers["X-Content-Type-Options"] = "nosniff"

        return response

    def rejected(request, code):
        if (
            hasattr(app.state, "store")
            and request.method in {"POST", "PUT", "DELETE", "PATCH"}
        ):
            principal = getattr(
                request.state, "principal", None
            )

            missions = (
                principal.mission_ids if principal else []
            )

            mission_id = (
                missions[0]
                if len(missions) == 1 and missions[0] != "*"
                else None
            )

            app.state.store.audit(
                "request.rejected",
                principal.user_id if principal else "anonymous",
                mission_id=mission_id,
                details={
                    "code": code,
                    "route": request.url.path.split("/")[2:3],
                    "resource": dict(request.path_params),
                },
            )

    @app.exception_handler(AppError)
    async def app_error(request, exc):
        rejected(request, exc.code)

        return error_response(
            request,
            exc.status_code,
            exc.code,
            exc.message,
            exc.details
        )

    @app.exception_handler(RequestValidationError)
    async def validation_error(request, exc):
        rejected(request, "validation_error")

        details = [
            {
                "location": list(error["loc"]),
                "message": error["msg"],
                "type": error["type"],
            }
            for error in exc.errors()
        ]

        return error_response(
            request,
            422,
            "validation_error",
            "Request did not match the API contract",
            details
        )

    @app.exception_handler(HTTPException)
    async def http_error(request, exc):
        return error_response(
            request,
            exc.status_code,
            "http_error",
            str(exc.detail)
        )

    @app.exception_handler(Exception)
    async def unexpected_error(request, exc):
        logging.getLogger(__name__).error(
            "Request failed: %s",
            type(exc).__name__
        )

        return error_response(
            request,
            500,
            "internal_error",
            "The request could not be completed"
        )

    # -----------------------------------------
    # SYSTEM HEALTH
    # -----------------------------------------

    @app.get("/api/health", tags=["system"])
    def health():
        return {
            "status": "ok",
            "environment": settings.environment,
            "local_schema_version": app.state.store.schema_version,
            "cloud_sync_configured": bool(
                settings.sync_rpc_url
                and settings.sync_access_token
            ),
            "prototype": True,
        }

    # -----------------------------------------
    # EXISTING API ROUTERS
    # -----------------------------------------

    from app.auth.router import router as auth
    from app.foundation.router import router as foundation
    from app.measurements.router import router as measurements
    from app.alerts.router import router as alerts
    from app.incidents.router import router as incidents
    from app.procedures.router import router as procedures
    from app.inventory.router import router as inventory
    from app.sync.router import router as sync
    from app.integrations.router import router as integrations

    for router in [
        auth,
        foundation,
        measurements,
        alerts,
        incidents,
        procedures,
        inventory,
        sync,
        integrations
    ]:
        app.include_router(router, prefix="/api")

    # -----------------------------------------
    # TEAM SQLITE DEVELOPMENT TESTS
    # -----------------------------------------

    if settings.environment == "development":

        from app.auth.dependencies import require
        from team_sqlite import get_db

        # Check the teammate's SQLite database

        @app.get(
            "/api/team-sqlite-check",
            tags=["SQLite Integration"]
        )
        def team_sqlite_check():
            with get_db() as db:
                rows = db.execute(
                    "SELECT name FROM sqlite_master "
                    "WHERE type='table' "
                    "AND name NOT LIKE 'sqlite_%'"
                ).fetchall()

            return {
                "connected": True,
                "table_count": len(rows)
            }

        # Read vital signs from the teammate's SQLite

        @app.get(
            "/api/team-sqlite-vitals",
            tags=["SQLite Integration"]
        )
        def team_sqlite_vitals(
            mission_id: str,
            principal=Depends(
                require("measurements:read")
            ),
        ):
            principal.require_mission(mission_id)

            with get_db() as db:
                rows = db.execute(
                    "SELECT * FROM vital_signs "
                    "WHERE mission_id = ? "
                    "ORDER BY measured_at DESC LIMIT 10",
                    (mission_id,)
                ).fetchall()

            return {
                "items": [dict(row) for row in rows]
            }

    # Dev2 modular domain routers (prototype only; secure Dev1 Store retained).
    from app.domain2.router import router as dev2_domain
    from app.domain2.reports import router as dev2_reports
    from app.domain2.baselines import router as dev2_baselines
    from app.domain2.vitals import router as dev2_vitals
    for added_router in [dev2_domain, dev2_reports, dev2_baselines, dev2_vitals]:
        app.include_router(added_router, prefix="/api")

    # TeamRocket Dev2 domain analysis + dashboard routers
    from app.domain2.analysis import router as dev2_analysis_router
    from app.domain2.dashboards import router as dev2_dashboard_router
    app.include_router(dev2_analysis_router, prefix="/api")
    app.include_router(dev2_dashboard_router, prefix="/api")

    return app


app = create_app()
